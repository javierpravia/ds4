@model IEnumerable<SistemaPasaportes.Models.Pasaporte>

@{
    ViewBag.Title = "Gestión de Pasaportes";
}

<h2>Sistema de Gestión de Pasaportes</h2>

<p>
    @Html.ActionLink("Nueva Solicitud", "Create", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Cédula</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th>Estado</th>
            <th>Fecha Solicitud</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Nombre</td>
                <td>@item.Cedula</td>
                <td>@item.Telefono</td>
                <td>@item.Email</td>
                <td>
                    @if (item.EstadoPasaporte == "Aprobado")
                    {
                        <span class="label label-success">@item.EstadoPasaporte</span>
                    }
                    else if (item.EstadoPasaporte == "Rechazado")
                    {
                        <span class="label label-danger">@item.EstadoPasaporte</span>
                    }
                    else if (item.EstadoPasaporte == "En Proceso")
                    {
                        <span class="label label-warning">@item.EstadoPasaporte</span>
                    }
                    else if (item.EstadoPasaporte == "Entregado")
                    {
                        <span class="label label-info">@item.EstadoPasaporte</span>
                    }
                    else
                    {
                        <span class="label label-default">@item.EstadoPasaporte</span>
                    }
                </td>
                <td>@item.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                <td>
                    @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-warning btn-sm" })

                    @using (Html.BeginForm("Delete", "Pasaportes", new { id = item.Id }, FormMethod.Post, new { style = "display:inline" }))
                    {
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('¿Está seguro de eliminar esta solicitud?');">
                            Eliminar
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <strong>No hay solicitudes registradas.</strong> Haga clic en "Nueva Solicitud" para agregar una.
    </div>
}
