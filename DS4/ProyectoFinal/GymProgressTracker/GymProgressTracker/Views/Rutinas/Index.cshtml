@model IEnumerable<GymProgressTracker.Models.MVC.Rutina>
@{
    ViewBag.Title = "Rutinas registradas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success">@TempData["MensajeExito"]</div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger">@TempData["MensajeError"]</div>
}

@using (Html.BeginForm("Agregar", "Rutinas", FormMethod.Post, new { @class = "form-ejercicio mb-4" }))
{
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label for="Nombre">Nombre de la rutina</label>
        <input id="Nombre" name="Nombre" class="form-control" type="text" required maxlength="100" />
    </div>
    <div class="form-group">
        <label for="Descripcion">Descripción</label>
        <input id="Descripcion" name="Descripcion" class="form-control" type="text" maxlength="255" />
    </div>
    <button type="submit" class="btn-success">Agregar rutina</button>
}

<h2>Rutinas registradas</h2>

@if (!Model.Any())
{
    <p>No hay rutinas registradas.</p>
}
else
{
    <div class="reg-cards">
        @foreach (var rutina in Model)
        {
            <div class="card card-lg">
                <div><b>@rutina.Nombre</b></div>
                @if (!string.IsNullOrWhiteSpace(rutina.Descripcion))
                {
                    <div><b>Descripción:</b> @rutina.Descripcion</div>
                }
            </div>
        }
    </div>
}